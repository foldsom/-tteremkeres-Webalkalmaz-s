.vs/
## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.sln.docstates

# Build results
[Dd]ebug/
[Rr]elease/
x64/
[Bb]in/
[Oo]bj/

# Test artifacts
[Tt]est[Rr]esult*/
coverage/

# Runtime db sidecar files
*.db-shm
*.db-wal

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Frontend outputs
node_modules/
dist/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.sw?
